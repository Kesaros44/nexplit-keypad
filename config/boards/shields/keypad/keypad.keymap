#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/backlight.h>

/ {
    behaviors {
        /* Windows 계산기 실행 매크로: GUI+R로 실행 대화상자를 연 뒤
           "calc"를 입력하고 Enter. DEL 키 위치에 바인딩됨 (default_layer). */
        calc_macro: calc_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_wait_time 100>
                , <&macro_tap &kp R>
                , <&macro_wait_time 100>
                , <&macro_release &kp LGUI>
                , <&macro_wait_time 300>
                , <&macro_tap &kp C &kp A &kp L &kp C &kp RET>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                                     &lt 1 BSPC       &calc_macro
                &kp KP_NUM           &kp KP_SLASH     &kp KP_MULTIPLY  &kp KP_MINUS
                &kp KP_N7            &kp KP_N8        &kp KP_N9        &kp KP_PLUS
                &kp KP_N4            &kp KP_N5        &kp KP_N6
                &kp KP_N1            &kp KP_N2        &kp KP_N3        &kp KP_ENTER
                &kp KP_N0                             &kp KP_DOT
            >;
        };

        settings_layer {
            bindings = <
                                     &trans           &bl BL_CYCLE
                &bl BL_TOG           &trans           &bt BT_CLR       &trans
                &trans               &trans           &trans           &trans
                &bt BT_SEL 3         &bt BT_SEL 4     &trans
                &bt BT_SEL 0         &bt BT_SEL 1     &bt BT_SEL 2     &trans
                &trans                                &trans
            >;
        };
    };
};
